{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Block dispatcher health: per-chain WSS liveness, block delivery rate, reconnect / failover events, SQS enqueue, and ethers v6 cleanup safety-net. Each panel is keyed by chain. Use the chain template variable at the top to filter.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Liveness — alert-worthy",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "One row per chain. Cross-reference seconds since last block, is_alive, active URL (primary/fallback), subscription state, socket age, and current chain URL index in a single table. Color thresholds match the side panels: < 30s green, 30-120s yellow, > 120s red on the time column; UP/DOWN colored on is_alive; primary/fallback colored on Active URL.",
      "fieldConfig": {
        "defaults": {
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Seconds since last block" },
            "properties": [
              { "id": "unit", "value": "s" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 30 },
                { "color": "red", "value": 120 }
              ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Alive" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Active URL" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "primary", "color": "blue" }, "1": { "text": "fallback", "color": "orange" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "blue", "value": null },
                { "color": "orange", "value": 1 }
              ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Subscription" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "off", "color": "red" }, "1": { "text": "on", "color": "green" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Reconnecting" },
            "properties": [
              { "id": "mappings", "value": [{ "type": "value", "options": { "0": { "text": "no", "color": "green" }, "1": { "text": "yes", "color": "orange" } } }] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [
                { "color": "green", "value": null },
                { "color": "orange", "value": 1 }
              ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Socket age" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "Last block #" },
            "properties": [{ "id": "unit", "value": "short" }]
          }
        ]
      },
      "gridPos": { "h": 16, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "Chain", "desc": false }],
        "footer": { "show": false, "reducer": ["sum"], "fields": "" }
      },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_seconds_since_last_block{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "A",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_is_alive{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "B",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_current_url_index{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "C",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_has_active_subscription{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "D",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_is_reconnecting{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "E",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_socket_age_seconds{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "F",
          "format": "table",
          "instant": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_last_processed_block{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "refId": "G",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "chain", "mode": "outer" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true, "Time 2": true, "Time 3": true,
              "Time 4": true, "Time 5": true, "Time 6": true, "Time 7": true
            },
            "renameByName": {
              "chain": "Chain",
              "Value #A": "Seconds since last block",
              "Value #B": "Alive",
              "Value #C": "Active URL",
              "Value #D": "Subscription",
              "Value #E": "Reconnecting",
              "Value #F": "Socket age",
              "Value #G": "Last block #"
            },
            "indexByName": {
              "chain": 0,
              "Value #B": 1,
              "Value #A": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7
            }
          }
        }
      ],
      "title": "Chain liveness (cross-reference)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 5,
      "title": "Block delivery",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Blocks delivered (after dedup) per chain, per second. Flatline = subscription has gone silent even though the connection looks alive.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "blocks / s",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (chain) (rate(keeperhub_block_dispatcher_blocks_received_total{namespace=~\"$namespace\",chain=~\"$chain\"}[5m]))",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "title": "Blocks received rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Highest block number processed per chain. Should advance monotonically; flatline aligns with the same flatline on 'Blocks received rate'.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisLabel": "block",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_last_processed_block{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "title": "Last processed block",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Time from block timestamp to receive on our side (wall_clock - block.timestamp). p95 > 30s on a fast chain like Ethereum indicates upstream lag.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "lag",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (chain, le) (rate(keeperhub_block_dispatcher_block_lag_seconds_bucket{namespace=~\"$namespace\",chain=~\"$chain\"}[5m])))",
          "legendFormat": "p50 {{chain}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (chain, le) (rate(keeperhub_block_dispatcher_block_lag_seconds_bucket{namespace=~\"$namespace\",chain=~\"$chain\"}[5m])))",
          "legendFormat": "p95 {{chain}}",
          "refId": "B"
        }
      ],
      "title": "Block lag (chain timestamp -> received) p50 / p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Blocks that matched at least one workflow interval, per chain, per second. Combined with the workflow_executions counter on the main app, this lets you spot dispatch-vs-execution divergence.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "matches / s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (chain) (rate(keeperhub_block_dispatcher_blocks_matched_total{namespace=~\"$namespace\",chain=~\"$chain\"}[5m]))",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "title": "Workflow trigger matches rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
      "id": 10,
      "title": "Connection lifecycle",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Age of the current WSS subscription per chain, in seconds. Resets to 0 on every reconnect (including the SOCKET_MAX_AGE_MS recycle every 1h). Should saw-tooth: climb to ~3600s, drop to 0, climb again.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "age",
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
      "id": 11,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_socket_age_seconds{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "title": "Socket age (per chain)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "WebSocket close events per chain, broken down by reason. upstream_close = server initiated; pong_timeout / block_advance_timeout / ping_send_failure = transport or push channel dead; socket_age_recycle = healthy 1h refresh; silent_failover = KEEP-557 URL flip; primary_probe_recovered = primary came back online.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "closes / s",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 35 },
      "id": 12,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (reason) (rate(keeperhub_block_dispatcher_ws_closes_total{namespace=~\"$namespace\",chain=~\"$chain\"}[5m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "title": "WS closes by reason",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Current consecutive BLOCK_ADVANCE_TIMEOUT_MS firings on the active URL with no real height advance in between. Resets on real block advance or URL flip. >= 1 sustained = upstream is silent on push channel even though connection looks alive.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "axisLabel": "count",
            "drawStyle": "line",
            "fillOpacity": 30,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "showPoints": "always",
            "thresholdsStyle": { "mode": "line+area" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
      "id": 13,
      "options": {
        "legend": { "calcs": ["max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "max by (chain) (keeperhub_block_dispatcher_silent_reconnects_current{namespace=~\"$namespace\",chain=~\"$chain\"})",
          "legendFormat": "{{chain}}",
          "refId": "A"
        }
      ],
      "title": "Silent reconnects (current)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "URL flips per chain by direction. to_fallback = SILENT_FAILOVER_THRESHOLD reached on primary, KEEP-557 swapped to Alchemy. to_primary = primary-recovery probe succeeded, swap back. Any sustained activity here means an upstream is being unreliable.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "flips",
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 43 },
      "id": 14,
      "options": {
        "legend": { "calcs": ["sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "sum by (chain, direction) (increase(keeperhub_block_dispatcher_url_flips_total{namespace=~\"$namespace\",chain=~\"$chain\"}[1h]))",
          "legendFormat": "{{chain}} {{direction}}",
          "refId": "A"
        }
      ],
      "title": "URL flips per hour",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "Distribution of reconnect-with-backoff durations: time from handleDisconnect() to next Block subscription active. p99 > 30s is unusual — likely indicates upstream is slow to accept new subscribes.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "duration",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 51 },
      "id": 15,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.50, sum by (chain, le) (rate(keeperhub_block_dispatcher_reconnect_duration_ms_bucket{namespace=~\"$namespace\",chain=~\"$chain\"}[15m])))",
          "legendFormat": "p50 {{chain}}",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.95, sum by (chain, le) (rate(keeperhub_block_dispatcher_reconnect_duration_ms_bucket{namespace=~\"$namespace\",chain=~\"$chain\"}[15m])))",
          "legendFormat": "p95 {{chain}}",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "histogram_quantile(0.99, sum by (chain, le) (rate(keeperhub_block_dispatcher_reconnect_duration_ms_bucket{namespace=~\"$namespace\",chain=~\"$chain\"}[15m])))",
          "legendFormat": "p99 {{chain}}",
          "refId": "C"
        }
      ],
      "title": "Reconnect duration p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 59 },
      "id": 16,
      "title": "Downstream + safety nets",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "SQS enqueue throughput per chain, split by outcome. Sustained error rate climbing is downstream of the dispatcher (SQS, IAM, network) — workflows are matching but not being queued.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisLabel": "enqueues / s",
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byRegexp", "options": ".*error.*" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 60 },
      "id": 17,
      "options": {
        "legend": { "calcs": ["mean", "sum"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
