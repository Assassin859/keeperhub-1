# KeeperHub self-hosted install settings.
#
#   cp .env.example .env      then fill in the REQUIRED section
#
# One file, read twice: once by the image build and once by install.sh. Fill it
# in before you build anything, because several values are compiled into the
# image and cannot be changed afterwards.
#
# QUOTE YOUR VALUES, as the examples do. The build reads this file with the
# shell, which strips quotes from what it reads, so an unquoted JSON value
# arrives with its own quotes missing and silently parses as empty.
#
# Never commit the .env you create. It is gitignored.

# ===========================================================================
# REQUIRED - the install will not work without these
# ===========================================================================

# Which cluster to install into. install.sh refuses to guess: a bare kubectl
# follows whatever context is current, and on a machine with production access
# that is how an install lands somewhere it should not.
#   kubectl config get-contexts
KUBE_CONTEXT=""

# A registry your cluster can pull from, and the repository inside it. Every
# component lands here under its own tag prefix. There is no public KeeperHub
# image; you build your own in step 2.
IMAGE_REPO="registry.yourcompany.com/keeperhub"

# The hostname the app is served on. Everything is derived from it: the ingress
# rule, the TLS certificate, and the URLs the app builds links from.
#
# Use a domain you control. Serve the app on a name this does not match and the
# UI loads and reads fine while every save returns 403.
APP_HOST="app.yourcompany.com"

# Your ingress controller's class, and a cert-manager ClusterIssuer for TLS.
#   kubectl get ingressclass
#   kubectl get clusterissuer
INGRESS_CLASS="nginx"
TLS_ISSUER="letsencrypt"

# Mail. REQUIRED because signup sends a six-digit code: with no working relay,
# nobody can create an account and the install is unusable. Invitations,
# password resets and API-key creation use the same path.
#
# A SendGrid key, or any relay speaking SendGrid's v3 mail/send API (set
# SENDGRID_API_URL below for that). The From address must be a sender identity
# verified in that account, or every send is rejected with 403.
SENDGRID_API_KEY=""
FROM_ADDRESS="noreply@yourcompany.com"

# ===========================================================================
# REQUIRED AT BUILD TIME - compiled into the image, and no Helm value changes
# them later. Getting one wrong means rebuilding.
#
# Every one may be left empty. Empty switches that feature off cleanly; wrong
# is what causes trouble.
# ===========================================================================

# Which sign-in buttons appear. Comma separated: email, github, google.
# A provider not listed here gets no button whatever keys you supply.
NEXT_PUBLIC_AUTH_PROVIDERS="email"

# Cloudflare Turnstile, the signup captcha. The site key is compiled in; its
# partner TURNSTILE_SECRET_KEY below is read at runtime. Supplying one without
# the other gives a signup form that renders and then fails.
#
# To skip Cloudflare entirely: leave both empty and set TURNSTILE_DISABLED=true.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# OAuth client ids. Their secrets are runtime values, further down.
NEXT_PUBLIC_GITHUB_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# Leave empty. A Sentry DSN compiled into the image sends your users' browser
# errors to whoever owns it, and the app proxies them through its own path, so
# the request leaves from your server rather than from the browser.
NEXT_PUBLIC_SENTRY_DSN=""

# ===========================================================================
# OPTIONAL - each one unlocks an area. Leave empty to leave it switched off.
# ===========================================================================

# --- Wallets and on-chain writes -------------------------------------------
# A Turnkey organisation of your own. Without it the pods still start and only
# wallet features fail: the Wallet overlay, every web3 write action, the
# protocol write actions and the Tempo steps.
TURNKEY_ORGANIZATION_ID=""
TURNKEY_API_PUBLIC_KEY=""
TURNKEY_API_PRIVATE_KEY=""

# --- Chain access ----------------------------------------------------------
# SET THIS BEFORE INSTALLING IF YOU SET IT AT ALL. Chain endpoints are written
# into the database when the migrator runs, so a value supplied afterwards
# leaves the websocket columns empty and the Block and Event triggers connect
# to nothing while every pod stays green.
#
# This is also the only way to configure a websocket endpoint. The per-chain
# CHAIN_<NAME>_PRIMARY_RPC variables are HTTP only.
#
# Reads work without it, on public endpoints seeded into your own database.
# A free Alchemy or Infura key is what makes websockets reliable.
#
# The keys are exact and a wrong one is ignored without warning. Ethereum's
# testnet is "eth-sepolia"; Base's is "base-testnet", not "base-sepolia".
#
# Example (one line):
# CHAIN_RPC_CONFIG='{"eth-sepolia":{"chainId":11155111,"symbol":"ETH","primaryRpcUrl":"https://eth-sepolia.g.alchemy.com/v2/KEY","primaryWssUrl":"wss://eth-sepolia.g.alchemy.com/v2/KEY","isEnabled":true,"isTestnet":true}}'
CHAIN_RPC_CONFIG=""

# --- Captcha ---------------------------------------------------------------
# The runtime half of Turnstile. Set TURNSTILE_DISABLED=true instead to skip
# Cloudflare: your signup endpoint then accepts automated requests, and the
# server warns about it at every boot.
TURNSTILE_SECRET_KEY=""
TURNSTILE_DISABLED="true"

# --- OAuth secrets ---------------------------------------------------------
# The runtime partners of the client ids above. The provider is enabled by the
# plain id being present, so set both halves or neither.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Smaller things --------------------------------------------------------
# Contract ABI auto-fetch in the workflow editor.
ETHERSCAN_API_KEY=""

# Wallet scanner enrichment. Without it /scan runs in native-only mode: it
# still works and shows less.
ZERION_API_KEY=""

# A relay other than SendGrid that speaks the same v3 mail/send shape.
SENDGRID_API_URL=""

# ===========================================================================
# INSTALL SHAPE - the defaults suit most installs
# ===========================================================================

NAMESPACE="keeperhub"

# bundled: the chart runs PostgreSQL through CloudNativePG and the queue
# through ElasticMQ, so you need no database and no AWS account.
# byo: you supply DATABASE_URL as a Secret, or a real SQS queue.
DB_MODE="bundled"
QUEUE_MODE="bundled"

# The Code step's execution sandbox. Without it every other step works and the
# Code step alone fails with a connection error.
SANDBOX_ENABLED="true"

# Sent to third-party geo providers on every sign-in, and they need no
# credential, so configuring nothing is not the same as sending nothing.
GEOIP_ENABLED="false"

# Deny all outbound traffic except what the product needs. Leave false for the
# first install, confirm it works, then turn it on. It only takes effect if
# your CNI enforces NetworkPolicy; the installer tells you which case you have.
EGRESS_POLICY="false"

# IMAGE_TAG is deliberately absent. It identifies one build rather than one
# install, so it is passed on the command line:
#   ENV_FILE=.env IMAGE_TAG=v1 ./install.sh
